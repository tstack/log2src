---
source: tests/test_cli.rs
info:
  program: log2src
  args:
    - match
    - "-d"
    - examples/basic.rs
    - "--message"
    - Hello from foo i=42
  env:
    APPDATA: /tmp/.tmp6FPZLM
    COLS: "1000"
    HOME: /tmp/.tmp6FPZLM
    LOCALAPPDATA: /tmp/.tmp6FPZLM
    USERPROFILE: /tmp/.tmp6FPZLM
    XDG_CONFIG_HOME: /tmp/.tmp6FPZLM
---
success: true
exit_code: 0
